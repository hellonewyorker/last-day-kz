{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/log-prompt.ps1"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
